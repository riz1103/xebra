# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://xebra-api.netlify.app

# Firebase Configuration
# Get these values from your Firebase project settings: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# AI exam generation (Firebase AI Logic / Gemini Developer API)
# Optional: override the Gemini model (defaults to gemini-flash-latest)
NEXT_PUBLIC_GEMINI_MODEL=
# Optional: cheaper model used once the backend's AI budget/daily limit is reached or the main
# model is over quota (defaults to gemini-flash-lite-latest). Limits are set on the backend
# (AI_PRIMARY_MONTHLY_BUDGET_USD, AI_PRIMARY_DAILY_REQUESTS_PER_USER).
NEXT_PUBLIC_GEMINI_FALLBACK_MODEL=
# reCAPTCHA Enterprise site key for Firebase App Check (strongly recommended in production
# so only your app can spend the AI quota)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only (ignored in production builds): App Check debug token registered in
# Firebase console > App Check > Apps > xebra-web > Manage debug tokens. Set to "true" to have the
# SDK generate one and print it in the browser console.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
