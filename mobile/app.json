{
  "expo": {
    "name": "Xevra",
    "slug": "xevra",
    "scheme": "xevra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xevra.app"
    },
    "android": {
      "package": "com.xevra.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "com.googleusercontent.apps.634489382731-5q3kbs4853thte9j84bc0lvdcvlmso1p"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Xevra uses photos of your notes to write practice questions."
        }
      ],
      "expo-audio",
      "expo-notifications",
      "expo-web-browser",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.634489382731-5q3kbs4853thte9j84bc0lvdcvlmso1p"
        }
      ]
    ]
  }
}
